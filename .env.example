# Copy this file to `.env` (which is git-ignored) and adjust the values.

# SQLite database file. Prisma resolves RELATIVE paths against the folder that
# contains `prisma/schema.prisma`, so `file:./dev.db` -> `prisma/dev.db`.
# Do NOT write `file:./prisma/dev.db` — that resolves to `prisma/prisma/dev.db`.
DATABASE_URL="file:./dev.db"

# HMAC key used to sign the `resort_admin_token` session cookie (HS256 via jose).
# Required in production (the app refuses to start without it) and must be at
# least 16 characters. Local dev falls back to a fixed development value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-string"
